terraform {
  required_version = ">= 1.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
  }

  # Backend local para AWS Academy (sin S3)
  backend "local" {
    path = "terraform.tfstate"
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = "emr-system"
      Environment = var.environment
      ManagedBy   = "terraform"
      Course      = "aws-academy"
    }
  }
}